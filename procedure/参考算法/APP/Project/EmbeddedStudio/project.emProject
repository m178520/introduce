    <configuration
      CMSIS_CORE="Yes"
      Name="Debug"
      c_preprocessor_definitions="USE_HAL_DRIVER;STM32H743xx"
      c_user_include_directories="..\\..\\Libraries\\CMSIS\\Include;..\\..\\Libraries\\CMSIS\\Device\\ST\\STM32H7xx\\Include;..\\..\\Libraries\\STM32H7xx_HAL_Driver\\Inc;..\\..\\User\\bsp\\inc;..\\..\\User;..\\..\\User\\bsp;..\\..\\User\\fonts"
